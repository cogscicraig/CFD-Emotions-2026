Button();\n\n    \/\/ --- 5. Remove cross & auto-advance after 2.5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp;<br>","DataExportTag":"Q2265","QuestionID":"QID2265"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID2266","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_3C22sivoSWTIaRU\" style=\"width: 400px; height: 281px;\" \/><\/div>","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"Q2258","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionID":"QID2266"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID2267","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_3C22sivoSWTIaRU\" style=\"width: 400px; height: 281px;\" \/><\/div>","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"Q2259","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden