.display = 'flex';\n    header.style.justifyContent = 'center';\n    header.style.alignItems = 'center';\n    header.style.minHeight = '100px';   \/\/ adjust to match original image height\n    header.style.background = 'white';  \/\/ remove if you want transparency\n\n    \/\/ --- 3. Add a single big bold plus sign ---\n    var cross = document.createElement('div');\n    cross.textContent = '+';\n    cross.style.fontSize = '150px';      \/\/ larger than before\n    cross.style.fontWeight = 'bold';\n    cross.style.lineHeight = '1';\n    cross.style.textAlign = 'center';\n\n    header.appendChild(cross);\n    document.body.insertBefore(header, document.body.firstChild);\n\n    \/\/ --- 4. Hide the Next button ---\n    this.hideNextButton();\n\n    \/\/ --- 5. Remove cross & auto-advance after 2.5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp;<br>","DataExportTag":"Q2390","QuestionID":"QID2390"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID2391","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","QuestionJS":false,"DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","IncludeDescription":"OFF"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validat