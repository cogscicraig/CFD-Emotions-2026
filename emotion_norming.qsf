accuracy of your response?<br \/>\n(0% = guessing; 100% = completely confident)","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How confident are you in the accuracy of your response? (0% = guessing; 100% = completely confident)","Choices":{"1":{"Display":"0%"},"2":{"Display":"20%"},"4":{"Display":"40%"},"5":{"Display":"60%"},"6":{"Display":"80%"},"7":{"Display":"100%"}},"ChoiceOrder":["1","2","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"How confident are you in the accuracy of your response?<br \/>\n(0% = guessing; 100% = completely confident)","DataExportTag":"Q4498","QuestionID":"QID4498"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID4499","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":28,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q4499","QuestionID":"QID4499"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID45","SecondaryAttribute":"\u00a0 \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img style=\"width: 400px; height: 281px;\" src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_79EREZqIDQDixsq\">&nbsp; &nbsp;<\/div>\n\n<div style=\"position:fixed; top:20px; left:20px; width:200px; z-index:1000;\" id=\"stickyImage\"><img src=\"yourImageURL.jpg\"><\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    var qDiv = document.getElementById(\"QID45\");\n\n    \/\/ If sticky header doesn't exist, create it\n    if (!document.getElementById(\"stickyHeader\")) {\n        var header = document.createElement(\"div\");\n        header.id = \"stickyHeader\";\n        header.style.width = \"100%\";\n        header.style.textAlign = \"center\";   \/\/ center the image\n        header.style.margin = \"0\";           \/\/ remove outer margins\n        header.style.padding = \"0\";          \/\/ remove padding\n        header.style.zIndex = \"9999\";\n        header.style.lineHeight = \"0\";       \/\/ kills extra vertical space\n\n        \/\/ Put it at the very top of the page (outside #Questions)\n        document.body.insertBefore(header, document.body.firstChild);\n    }\n\n    \/\/ Clean up default Qualtrics styling on the image question container\n    qDiv.style.margin = \"0\";\n    qDiv.style.padding = \"0\";\n    qDiv.style.lineHeight = \"0\";\n    qDiv.style.border = \"none\";\n\n    \/\/ Move the image question into the header\n    document.getElementById(\"stickyHeader\").appendChild(qDiv);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 \u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionText_Unsafe":"<div style=\"text-align: center;\">&nbsp;&nbsp; <img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_3wqGqUAf8sOvPLM\" style=\"width: 399px; height: 280px;\" \/><\/div>\n\n<div id=\"stickyImage\" style=\"position:fixed; top:20px; left:20px; width:200px; z-index:1000;\"><img src=\"yourImageURL.jpg\" \/><\/div>","DataExportTag":"CFD-WF-003-004-HO","QuestionID":"QID45"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID450","SecondaryAttribute":"\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;<br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/\/ --- 1. Remove any existing sticky header first ---\n    var existing = document.getElementById('stickyHeader');\n    if (existing) existing.remove();\n\n    \/\/ --- 2. Create the single sticky header ---\n    var header = document.createElement('div');\n    header.id = 'stickyHeader';\n    header.style.width = '100%';\n    header.style.position = 'fixed';\n    header.style.top = '0';\n    header.style.left = '0';\n    header.style.zIndex = '9999';\n\n    \/\/ Center the content\n    header.style.display = 'flex';\n    header.style.justifyContent = 'center';\n    header.style.alignItems = 'center';\n    header.style.minHeight = '100px';   \/\/ adjust to match original image height\n    header.style.background = 'white';  \/\/ remove if you want transparency\n\n    \/\/ --- 3. Add a single big bold plus sign ---\n    var cross = document.createElement('div');\n    cross.textContent = '+';\n    cross.style.fontSize = '150px';      \/\/ larger than before\n    cross.style.fontWeight = 'bold';\n    cross.style.lineHeight = '1';\n    cross.style.textAlign = 'center';\n\n    header.appendChild(cross);\n    document.body.insertBefore(header, document.body.firstChild);\n\n    \/\/ --- 4. Hide the Next button ---\n    this.hideNextButton();\n\n    \/\/ --- 5. Remove cross & auto-advance after 2.5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescription