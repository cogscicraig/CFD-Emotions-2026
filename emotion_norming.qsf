.firstChild);\n\n        \/\/ Hide the original image question\n        imageQDiv.style.display = \"none\";\n    }\n});"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID160","SecondaryAttribute":"On a scale from 1 (totally unclear) to 5 (totally clear), please rate the clarity with which ...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">On a scale from 1 (totally unclear) to 5 (totally clear), please rate the <b>clarity<\/b> with which ${q:\/\/QID158\/ChoiceGroup\/SelectedChoices}&nbsp;is being expressed.<\/div>","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"On a scale from 1 (totally unclear) to 5 (totally clear), please rate the clarity with which ...","Choices":{"1":{"Display":"1 (totally unclear)"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5 (totally clear)"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    var questionText = this.getQuestionTextContainer();\n    var html = questionText.innerHTML;\n\n    \/\/ Replace raw text values with friendly versions\n    html = html.replace(\"neutral\", \"any emotion\");\n    html = html.replace(\"none of the above\", \"any emotion\");\n\n    questionText.innerHTML = html;\n});","QuestionText_Unsafe":"<div style=\"text-align: center;\">On a scale from 1 (totally unclear) to 5 (totally clear), please rate the <b>clarity<\/b> with which ${q:\/\/QID158\/ChoiceGroup\/SelectedChoices}&nbsp;is being expressed.<\/div>","DataExportTag":"Q160","QuestionID":"QID160"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1600","SecondaryAttribute":"On a scale from 1 (totally uncle