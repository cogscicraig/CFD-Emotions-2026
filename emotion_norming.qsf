y confident)","Choices":{"1":{"Display":"0%"},"2":{"Display":"20%"},"4":{"Display":"40%"},"5":{"Display":"60%"},"6":{"Display":"80%"},"7":{"Display":"100%"}},"ChoiceOrder":["1","2","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"How confident are you in the accuracy of your response?<br \/>\n(0% = guessing; 100% = completely confident)","DataExportTag":"Q4738","QuestionID":"QID4738"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID4739","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":28,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q4739","QuestionID":"QID4739"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID474","SecondaryAttribute":"\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;<br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/\/ --- 1. Remove any existing sticky header first ---\n    var existing = document.getElementById('stickyHeader');\n    if (existing) existing.remove();\n\n    \/\/ --- 2. Create the single sticky header ---\n    var header = document.createElement('div');\n    header.id = 'stickyHeader';\n    header.style.width = '100%';\n    header.style.position = 'fixed';\n    header.style.top = '0';\n    header.style.left = '0';\n    header.style.zIndex = '9999';\n\n    \/\/ Center the content\n    header.style.display = 'flex';\n    header.style.justifyContent = 'center';\n    header.style.alignItems = 'center';\n    header.style.minHeight = '100px';   \/\/ adjust to match original image height\n    header.style.background = 'white';  \/\/ remove if you want transparency\n\n    \/\/ --- 3. Add a single big bold plus sign ---\n    var cross = document.createElement('div');\n    cross.textContent = '+';\n    cross.style.fontSize = '150px';      \/\/ larger than before\n    cross.style.fontWeight = 'bold';\n    cross.style.lineHeight = '1';\n    cross.style.textAlign = 'center';\n\n    header.appendChild(cross);\n    document.body.insertBefore(header, document.body.firstChild);\n\n    \/\/ --- 4. Hide the Next button ---\n    this.hideNextButton();\n\n    \/\/ --- 5. Remove cross & auto-advance after 2.5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp;<br>","DataExportTag":"Q474","QuestionID":"QID474"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID4740","SecondaryAttribute":"\u00a0 \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp; &nbsp;<br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\tthis.hideNextButton();\n\tthis.clickNextButton.delay(0.5)\n\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 \u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[]