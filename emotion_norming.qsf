y){\n    var done  = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(doneKey)  || \"0\", 10);\n    var total = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(totalKey) || \"1\", 10);\n    total = Math.max(total, 1);\n    done = Math.min(done + 1, total);\n    Qualtrics.SurveyEngine.setEmbeddedData(doneKey, String(done));\n  }\n\n  if (phase === \"norming\") inc(\"norm_done\", \"norm_total\");\n  if (phase === \"memory\")  inc(\"mem_done\",  \"mem_total\");\n\n  Qualtrics.SurveyEngine.setEmbeddedData(key, \"1\");\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionText_Unsafe":"<div style=\"text-align: center;\">\\ <img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_b7017rPEDlPqvLE\" style=\"width: 399px; height: 280px;\" \/><\/div>","DataExportTag":"Q435","QuestionID":"QID435"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID4350","SecondaryAttribute":"\u00a0 \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp; &nbsp;<br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\tthis.hideNextButton();\n\tthis.clickNextButton.delay(0.5)\n\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 \u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp; &nbsp;<br>","DataExportTag":"Q4350","QuestionID":"QID4350"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID4351","SecondaryAttribute":" ","Terti