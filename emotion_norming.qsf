portTag":"Q1294","QuestionID":"QID1294"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1295","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_54k4aTCNF3HeuH4\" style=\"width: 400px; height: 281px;\" \/><\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionText_Unsafe":"<div style=\"text-align: center;\"><img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_54k4aTCNF3HeuH4\" style=\"width: 400px; height: 281px;\" \/><\/div>","DataExportTag":"Q1295","QuestionID":"QID1295"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1296","SecondaryAttribute":"On a scale from 1 (appears faked) to 5 (appears genuine), please rate how genuine this expression...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">On a scale from 1 (appears faked) to 5 (appears genuine), please rate how <b>genuine<\/b> this expression of ${q:\/\/QID1290\/ChoiceGroup\/SelectedChoices}&nbsp;appears to you.<\/div>","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"On a scale from 1 (appears faked) to 5 (appears genuine), please rate how genuine this expression...","Choices":{"1":{"Display":"1 (appears faked)"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5 (appears genuine)"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    var questionText = this.getQuestionTextContainer();\n    var html = questionText.innerHTML;\n\n    \/\/ Replace raw text values with friendly versions\n    html = html.replace(\"neutral\", \"any emotion\");\n    html = html.replace(\"none of the above\", \"any emotion\");\n\n    questionText.innerHTML = html;\n});","QuestionText_Unsafe":"<div style=\"text-align: center;\">On a scale from 1 (appears faked) to 5 (appears genuine), please rate how <b>genuine<\/b> this expression of ${q:\/\/QID1290\/ChoiceGroup\/SelectedChoices}&nbsp;appears to you.<\/div>","DataExportTag":"Q1296","QuestionID":"QID1296"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1297","SecondaryAttribute":"\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;<br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/\/ --- 1. Remove any existing sticky header first ---\n    var existing = document.getElementById('stickyHeader');\n    if (existing) existing.remove();\n\n    \/\/ --- 2. Create the single sticky header ---\n    var header = document.createElement('div');\n    header.id = 'stickyHeader';\n    header.style.width = '100%';\n    header.style.position = 'fixed';\n    header.style.top = '0';\n    header.style.left = '0';\n    header.style.zIndex = '9999';\n\n    \/\/ Center the content\n    header.style.display = 'flex';\n    header.style.justifyContent = 'center';\n    header.style.alignItems = 'center';\n    header.style.minHeight = '100px';   \/\/ adjust to match original image height\n    header.style.background = 'white';  \/\/ remove if you want transparency\n\n    \/\/ --- 3. Add a single big bold plus sign ---\n    var cross = document.createElement('div');\n    cross.textContent = '+';\n    cross.style.fontSize = '150px';      \/\/ larger than before\n    cross.style.fontWeight = 'bold';\n    cross.style.lineHeight = '1';\n    cross.style.textAlign = 'center';\n\n    header.appendChild(cross);\n    document.body.insertBefore(header, document.body.firstChild);\n\n    \/\/ --- 4. Hide the Next button ---\n    this.hideNextButton();\n\n    \/\/ --- 5. Remove cross & auto-advance after 2.5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp;<br>","DataExportTag":"Q1297","QuestionID":"QID1297"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1298","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_cT56zwz82rlgVE2\" style=\"width: 400px; height: 281px;\" \/><\/div>","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"Q1290","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionID":"QID1298"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1299","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_cT56zwz82rlgVE2\" style=\"width: 400px; height: 281px;\" \/><\/div>","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"Q1291","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionID":"QID1299"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID130","SecondaryAttribute":"Thanks for taking our survey!\u00a0 \u00a0 In this study, we are investigating how individuals perceive emo.","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Thanks for taking our survey!&nbsp;<\/strong><br>\n&nbsp;<br><strong><em>In this study, we are investigating how individuals perceive emotional expressions in human faces. <br><br>You were shown a series of images containing faces and were asked to identify the emotion being expressed in each image. This helps us understand how accurately people are able recognize emotions like anger, happiness, fear, and others, <i>based on facial expression alone<\/i>.<br><br>Researchers and clinicians often rely on carefully selected images of facial expressions in studies of social interaction, mental health, and even training AI models. But before we can use these images in scientific studies, we need to make sure they are interpreted consistently. In other words, we need to be confident that most people agree on what emotion is being shown. Your responses on this survey will help us determine whether the images we selected are clear and reliable. <br><br>Our broader goal is to validate a set of emotional face stimuli that researchers can use in future experiments. These images could be used to study things like emotion perception across cultures, individual differences in emotional processing, or even how emotional cues affect memory and decision-making.<br><br>We didn\u2019t share our full goals at the beginning of the study because we wanted to avoid influencing your answers. But now that the task is done, we\u2019d love to hear what you thought the study was about. Were any emotions harder to recognize? Did some faces feel more ambiguous than others?\nIf you're curious, we also invite you to make a prediction: Which emotion do you think people tend to confuse the most?<br><br>Thanks again for helping us improve research tools for studying human emotion!\n<br><br>__________________________<br><br>\nIf you would like to email the study creator, please direct your email to xby5us@virgnia.edu.<\/em><\/strong><br>\n<br>Emily Ives<br>\nDepartment of Psychology<br>\nUniversity of Virginia<br>\nCharlottesville, VA 22904<br>\n(434) 924 - 4237<br>\n<br>\n&nbsp;","DefaultChoices":false,"DataExportTag":"Q122","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thanks for taking our survey!\u00a0 \u00a0 In this study, we are investigating how individuals perceive emo...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID130"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1300","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_cT56zwz82rlgVE2\" style=\"width: 400px; height: 281px;\" \/><\/div>","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"Q1292","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Sett