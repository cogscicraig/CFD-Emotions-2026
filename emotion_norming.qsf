HTML;\n\n    \/\/ Replace raw text values with friendly versions\n    html = html.replace(\"neutral\", \"any emotion\");\n    html = html.replace(\"none of the above\", \"any emotion\");\n\n    questionText.innerHTML = html;\n});","QuestionText_Unsafe":"<div style=\"text-align: center;\">On a scale from 1 (weak intensity) to 5 (strong intensity), please rate the <b>intensity<\/b> with which&nbsp;${q:\/\/QID1217\/ChoiceGroup\/SelectedChoices}&nbsp;is being expressed.<\/div>","DataExportTag":"Q1219","QuestionID":"QID1219"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1219092885","SecondaryAttribute":"Thank you for participating in this study! You will be shown a series of faces with different exp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:22px;\"><span style=\"font-family: arial,helvetica,sans-serif;\">Thank you for participating in this study! <br><br>You will be shown a series of faces with different expressions. Your job is to answer questions regarding how you perceive each face.\r\nThere are no right or wrong answers; we are interested in how you interpret the images.&nbsp;<strong>Please respond to each of the questions you see as it pertains to the face shown simultaneously on the screen<\/strong>.<br>\n<br>\nEach trial will end with a fixation cross (<b>+<\/b>) indicating that the trial is over. Attend to the cross as you wait for the next image to appear.<\/span><\/span>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for participating in this study! You will be shown a series of faces with different exp...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<span style=\"font-size:22px;\"><span style=\"font-family: arial,helvetica,sans-serif;\">You will see a series of faces.&nbsp;<strong>Please pay close attention <\/strong>to each of the faces&nbsp;because after a delay we will ask you questions about who you saw, and you will need to remember them.&nbsp;<\/span><\/span>\n<div>&nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size: 22px;\">Some faces will appear normally, and others will have either a mask or sunglasses.&nbsp;<\/span><span style=\"font-size: 22px;\">Each face will be shown for <b>3 seconds.&nbsp;<\/b><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<div>&nbsp;<\/div>\n\n<div><span style=\"font-size: 22px;\">You may be shown some faces twice, so be prepared to see some of the same people.&nbsp;<\/span><\/div>\n\n<div>\n<div>&nbsp;<\/div>\n<\/div>","PrivateData":false,"DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"DataExportTag":"Q1","QuestionID":"QID1219092885","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n\n  function clamp(n,a,b){ return Math.max(a, Math.min(b,n)); }\n\n  var show  = (Qualtrics.SurveyEngine.getEmbeddedData(\"pb_show\") || \"0\") === \"1\";\n  var done  = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"pb_done\")  || \"0\", 10);\n  var total = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"pb_total\") || \"1\", 10);\n  total = Math.max(total, 1);\n\n  var wrap  = document.getElementById(\"pb_wrap\");\n  var bar   = document.getElementById(\"pb_bar\");\n  var label = document.getElementById(\"pb_label\");\n\n  if (!wrap || !bar) return;\n\n  if (!show) {\n    wrap.style.display = \"none\";\n    return;\n  }\n\n  wrap.style.display = \"block\";\n\n  var pct = clamp((done \/ total) * 100, 0, 100);\n  bar.style.width = pct + \"%\";\n\n  \/\/ Optional label (leave blank if you don't want text)\n  var phaseLabel = Qualtrics.SurveyEngine.getEmbeddedData(\"pb_label\") || \"\";\n  if (label) label.textContent = phaseLabel;\n});"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1219092886","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"Que