ion () {\n    var headerId = 'stickyHeader';\n    var qDiv = document.getElementById(\"QID1219092932\"); \/\/ \ud83d\udc48 replace with your image question's QID\n\n    if (!qDiv) return;\n\n    \/\/ --- Check if header already exists ---\n    if (!document.getElementById(headerId)) {\n        \/\/ Create sticky header\n        var header = document.createElement('div');\n        header.id = headerId;\n        header.style.width = '100%';\n        header.style.position = 'fixed';\n        header.style.top = '0';\n        header.style.left = '0';\n        header.style.zIndex = '9999';\n        header.style.textAlign = 'center';\n        header.style.background = 'white';\n        header.style.minHeight = '100px';\n        header.style.display = 'flex';\n        header.style.justifyContent = 'center';\n        header.style.alignItems = 'center';\n\n        \/\/ Clone the image question into the header\n        var clone = qDiv.cloneNode(true);\n        clone.style.display = 'block';\n        header.appendChild(clone);\n\n        \/\/ Insert header at top of page\n        document.body.insertBefore(header, document.body.firstChild);\n    }\n\n    \/\/ Hide the original question\n    qDiv.style.display = 'none';\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionText_Unsafe":"&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_e3tZiBPIiiVzzE1\" style=\"width: 320px; height: 400px;\" \/>","DataExportTag":"CFD-WF-001-009-HO","QuestionID":"QID1219092932"}},{"SurveyID":"SV_