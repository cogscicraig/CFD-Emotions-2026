2923","SecondaryAttribute":"\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;<br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/\/ --- 1. Remove any existing sticky header first ---\n    var existing = document.getElementById('stickyHeader');\n    if (existing) existing.remove();\n\n    \/\/ --- 2. Create the single sticky header ---\n    var header = document.createElement('div');\n    header.id = 'stickyHeader';\n    header.style.width = '100%';\n    header.style.position = 'fixed';\n    header.style.top = '0';\n    header.style.left = '0';\n    header.style.zIndex = '9999';\n\n    \/\/ Center the content\n    header.style.display = 'flex';\n    header.style.justifyContent = 'center';\n    header.style.alignItems = 'center';\n    header.style.minHeight = '100px';   \/\/ adjust to match original image height\n    header.style.background = 'white';  \/\/ remove if you want transparency\n\n    \/\/ --- 3. Add a single big bold plus sign ---\n    var cross = document.createElement('div');\n    cross.textContent = '+';\n    cross.style.fontSize = '150px';      \/\/ larger than before\n    cross.style.fontWeight = 'bold';\n    cross.style.lineHeight = '1';\n    cross.style.textAlign = 'center';\n\n    header.appendChild(cross);\n    document.body.insertBefore(header, document.body.firstChild);\n\n    \/\/ --- 4. Hide the Next button ---\n    this.hideNextButton();\n\n    \/\/ --- 5. Remove cross & auto-advance after 2.5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp;<br>","DataExportTag":"Q2923","QuestionID":"QID2923"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID2924","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img style=\"width: 399px; height: 280px;\" src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_cBkug1FNFpSLI4w\"><\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n  var phase = Qualtrics.SurveyEngine.getEmbeddedData(\"phase\") || \"\";\n\n  var key = \"counted_\" + this.questionId;\n  if (Qualtrics.SurveyEngine.getEmbeddedData(key) === \"1\") return;\n\n  function inc(doneKey, totalKey){\n    var done  = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(doneKey)  || \"0\", 10);\n    var total = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(totalKey) || \"1\", 10);\n    total = Math.max(total, 1);\n    done = Math.min(done + 1, total);\n    Qualtrics.SurveyEngine.setEmbeddedData(doneKey, String(done));\n  }\n\n  if (phase === \"norming\") inc(\"norm_done\", \"norm_total\");\n  if (phase === \"memory\")  inc(\"mem_done\",  \"mem_total\");\n\n  Qualtrics.SurveyEngine.setEmbeddedData(key, \"1\");\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionText_Unsafe":"<div style=\"text-align: center;\">&nbsp;&nbsp; <img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_b9jE24rrIOxG8ia\" style=\"width: 399px; height: 280px;\" \/><\/div>","DataExportTag":"Q2924","QuestionID":"QID2924"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAt