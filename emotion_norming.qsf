e\n    \/\/ -------------------------------\n    var headerQID = \"QID1219092932\";  \/\/ \ud83d\udc48 replace with your image question QID\n    var headerId = \"stickyHeader\";\n    var imageQDiv = document.getElementById(headerQID);\n\n    if (imageQDiv && !document.getElementById(headerId)) {\n        var header = document.createElement(\"div\");\n        header.id = headerId;\n        header.style.width = \"100%\";\n        header.style.position = \"fixed\";\n        header.style.top = \"0\";\n        header.style.left = \"0\";\n        header.style.zIndex = \"9999\";\n        header.style.textAlign = \"center\";\n        header.style.background = \"white\";\n        header.style.minHeight = \"100px\";\n        header.style.display = \"flex\";\n        header.style.justifyContent = \"center\";\n        header.style.alignItems = \"center\";\n\n        \/\/ Clone the image question into the header\n        var clone = imageQDiv.cloneNode(true);\n        clone.style.display = \"block\";\n        header.appendChild(clone);\n\n        document.body.insertBefore(header, document.body.firstChild);\n\n        \/\/ Hide the original image question\n        imageQDiv.style.display = \"none\";\n    }\n});"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID150","SecondaryAttribute":"Which of these labels best describes the facial expression currently on display?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of these labels best describes the facial expression currently on display?<br>","QuestionType":"MC","Selector":"SACOL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW","NumColumns":3},"QuestionDescription":"Which of these labels best describes the facial expression currently on display?","Choices":{"1":{"Display":"happiness"},"2":{"Display":"sadness"},"3":{"Display":"anger"},"4":{"Display":"fear"},"5":{"Display":"surprise"},"6":{"Display":"disgust"},"7":{"D