r.style.background = 'white';  \/\/ remove if you want transparency\n\n    \/\/ --- 3. Add a single big bold plus sign ---\n    var cross = document.createElement('div');\n    cross.textContent = '+';\n    cross.style.fontSize = '150px';      \/\/ larger than before\n    cross.style.fontWeight = 'bold';\n    cross.style.lineHeight = '1';\n    cross.style.textAlign = 'center';\n\n    header.appendChild(cross);\n    document.body.insertBefore(header, document.body.firstChild);\n\n    \/\/ --- 4. Hide the Next button ---\n    this.hideNextButton();\n\n    \/\/ --- 5. Remove cross & auto-advance after 2.5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp;<br>","DataExportTag":"Q1748","QuestionID":"QID1748"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1749","SecondaryAttribute":"\u00a0 \u00a0\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">&nbsp; &nbsp;&nbsp; <img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_dbACMwlQXxCRyrs\" style=\"width: 400px; height: 281px;\" \/><\/div>","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"Q1741","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 \u00a0\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"N