767\");\n\n    if (qDiv) {\n        \/\/ Tighten QID8 itself\n        qDiv.style.margin = \"2px 0\";     \/\/ very small vertical margin\n        qDiv.style.padding = \"2px 0\";    \/\/ very small vertical padding\n        qDiv.style.lineHeight = \"1\";\n        qDiv.style.border = \"none\";\n\n        \/\/ Also shrink its wrapper (Qualtrics often uses QuestionOuter)\n        var outer = qDiv.closest(\".QuestionOuter\");\n        if (outer) {\n            outer.style.marginTop = \"0\";\n            outer.style.paddingTop = \"0\";\n        }\n\n        \/\/ And the text container (if present)\n        var textContainer = qDiv.querySelector(\".QuestionTextContainer\");\n        if (textContainer) {\n            textContainer.style.marginTop = \"0\";\n            textContainer.style.paddingTop = \"0\";\n        }\n\n        \/\/ Clean up any image spacing inside\n        qDiv.querySelectorAll(\"img\").forEach(img => {\n            img.style.display = \"block\";\n            img.style.margin = \"2px auto\"; \/\/ just a touch of space\n        });\n    }\n});","QuestionText_Unsafe":"<div style=\"text-align: center;\">How <b>positive<\/b> (pleasant) or <b>negative<\/b> (unpleasant) does the person in this image appear to be feeling?<br>\n&nbsp;<\/div>","DataExportTag":"Q2483","QuestionID":"QID2483"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID2484","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","QuestionJS":false,"DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionText_Unsafe":"Click to