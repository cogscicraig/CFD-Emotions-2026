 often uses QuestionOuter)\n        var outer = qDiv.closest(\".QuestionOuter\");\n        if (outer) {\n            outer.style.marginTop = \"0\";\n            outer.style.paddingTop = \"0\";\n        }\n\n        \/\/ And the text container (if present)\n        var textContainer = qDiv.querySelector(\".QuestionTextContainer\");\n        if (textContainer) {\n            textContainer.style.marginTop = \"0\";\n            textContainer.style.paddingTop = \"0\";\n        }\n\n        \/\/ Clean up any image spacing inside\n        qDiv.querySelectorAll(\"img\").forEach(img => {\n            img.style.display = \"block\";\n            img.style.margin = \"2px auto\"; \/\/ just a touch of space\n        });\n    }\n});","QuestionText_Unsafe":"<div style=\"text-align: center;\">How positive (pleasant) or negative (unpleasant) does the person in the image appear to be feeling?<br \/>\n&nbsp;<\/div>","DataExportTag":"Q87","QuestionID":"QID87"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID870","SecondaryAttribute":"\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_eEy1YMgYUKaC7A2\" style=\"width: 399px; height: 280px;\" \/><\/div>","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"Q862","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionID":"QID870"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID871","Secon