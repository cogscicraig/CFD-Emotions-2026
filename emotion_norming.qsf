5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp;<br>","DataExportTag":"Q3001","QuestionID":"QID3001"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID3002","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img style=\"width: 399px; height: 280px;\" src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_q6pVtiqNN1aEzW4\"><\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionText_Unsafe":"<div style=\"text-align: center;\">&nbsp;&nbsp; <img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_b9jE24rrIOxG8ia\" style=\"width: 399px; height: 280px;\" \/><\/div>","DataExportTag":"Q3002","QuestionID":"QID3002"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID3003","SecondaryAttribute":"How positive (pleasant) or negative (unpleasant) does the person in this image appear to be feeli...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">How <b>positive<\/b> (pleasant) or <b>neg