 exist, create it\n    if (!document.getElementById(\"stickyHeader\")) {\n        var header = document.createElement(\"div\");\n        header.id = \"stickyHeader\";\n        header.style.width = \"100%\";\n        header.style.textAlign = \"center\";\n        header.style.margin = \"0\";\n        header.style.padding = \"0\";\n        header.style.zIndex = \"9999\";\n        header.style.lineHeight = \"0\";\n\n        document.body.insertBefore(header, document.body.firstChild);\n    }\n\n    \/\/ Hide the original so it doesn't render in the block\n    qDiv.style.display = \"none\";\n\n    \/\/ Copy its contents into the header\n    var clone = qDiv.cloneNode(true);\n    clone.style.display = \"block\"; \/\/ ensure clone is visible\n    var header = document.getElementById(\"stickyHeader\");\n    header.innerHTML = \"\"; \/\/ clear previous copy if any\n    header.appendChild(clone);\n});","DefaultChoices":false,"DataExportTag":"Q791","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 \u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionID":"QID799"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"How positive (pleasant) or negative (unpleasant) does the person in this image appear to be feeli...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">How <b>positive<\/b> (pleasant) or <b>negative<\/b> (unpleasant) does the person in this image appear to be feeling?<br>\n&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"Valence","QuestionID":"QID8","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":0,"NumDecimals":"0","ShowValue":false,"CustomStart":true,"NotApplicable":false,"MobileFirst":false,"SliderStartPositions":{"1":0.50283553875236297603379398424294777214527130126953125},"SnapToGrid":false},"QuestionDescription":"How positive (pleasant) or negative (unpleasant) does the person in this image appear to be feeli...","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"Negative"},"2":{"Display":"Positive"}},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    var qDiv = document.getElementById(\"QID8\");          \/\/ The question to tighten\n    var headerQID = \"QID1219092932\";                     \/\/ The question that has the image for sticky header\n    var headerId = \"stickyHeader\";\n\n    \/\/ --- Tighten QID8 ---\n    if (qDiv) {\n        qDiv.style.margin = \"2px 0\";     \n        qDiv.style.padding = \"2px 0\";    \n        qDiv.style.lineHeight = \"1\";\n        qDiv.style.border = \"none\";\n\n        var outer = qDiv.closest(\".QuestionOuter\");\n        if (outer) {\n            outer.style.marginTop = \"0\";\n            outer.style.paddingTop = \"0\";\n        }\n\n        var textContainer = qDiv.querySelector(\".QuestionTextContainer\");\n        if (textContainer) {\n            textContainer.style.marginTop = \"0\";\n            textContainer.style.paddingTop = \"0\";\n        }\n\n        qDiv.querySelectorAll(\"img\").forEach(img => {\n            img.style.display = \"block\";\n            img.style.margin = \"2px auto\";\n        });\n    }\n\n    \/\/ --- Sticky header image ---\n    var imageQDiv = document.getElementById(headerQID);\n    if (imageQDiv && !document.getElementById(headerId)) {\n        var header = document.createElement(\"div\");\n        header.id = headerId;\n        header.style.width = \"100%\";\n        header.style.position = \"fixed\";\n        header.style.top = \"0\";\n        header.style.left = \"0\";\n        header.style.zIndex = \"9999\";\n        header.style.textAlign = \"center\";\n        header.style.background = \"white\";\n        header.style.minHeight = \"100px\";\n        header.style.display = \"flex\";\n        header.style.justifyContent = \"center\";\n        header.style.alignItems = \"center\";\n\n        var clone = imageQDiv.cloneNode(true);\n        clone.style.display = \"block\";\n        header.appendChild(clone);\n\n        document.body.insertBefore(header, document.body.firstChild);\n\n        \/\/ Hide original image question\n        imageQDiv.style.display = \"none\";\n    }\n});"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID80","SecondaryAttribute":"How emotionally activated or energized does the person in the image appear to be feeling?","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">How emotionally activated or energized does the person in the image appear to be feeling?<\/div>","DefaultChoices":false,"QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":0,"SnapToGrid":false,"NumDecimals":"0","ShowValue":false,"CustomStart":false,"SliderStartPositions":{"1":0.47205882352941175295057973926304839551448822021484375},"NotApplicable":false,"MobileFirst":false},"QuestionDescription":"How emotionally activated or energized does the person in the image appear to be feeling?","Choices":{"1":{"Display":""}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"Low energy"},"2":{"Display":"High energy"}},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    var qDiv = document.ge