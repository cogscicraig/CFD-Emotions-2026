 = '+';\n    cross.style.fontSize = '150px';      \/\/ larger than before\n    cross.style.fontWeight = 'bold';\n    cross.style.lineHeight = '1';\n    cross.style.textAlign = 'center';\n\n    header.appendChild(cross);\n    document.body.insertBefore(header, document.body.firstChild);\n\n    \/\/ --- 4. Hide the Next button ---\n    this.hideNextButton();\n\n    \/\/ --- 5. Remove cross & auto-advance after 2.5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp;<br>","DataExportTag":"Q1531","QuestionID":"QID1531"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1532","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_ePXrqGSVgDC76Qe\" style=\"width: 399px; height: 280px;\" \/><\/div>","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"Q1524","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionID":"QID1532"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID1533","SecondaryAttribute":" ","TertiaryAttribute":n