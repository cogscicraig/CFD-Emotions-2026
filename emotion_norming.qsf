\").appendChild(qDiv);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 \u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionText_Unsafe":"<div style=\"text-align: center;\"><img style=\"width: 400px; height: 281px;\" src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_79EREZqIDQDixsq\">&nbsp; &nbsp;<\/div>\n\n<div style=\"position:fixed; top:20px; left:20px; width:200px; z-index:1000;\" id=\"stickyImage\"><img src=\"yourImageURL.jpg\"><\/div>","DataExportTag":"CFD-WF-003-007-HC","QuestionID":"QID53"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID530","SecondaryAttribute":"\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;<br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/\/ --- 1. Remove any existing sticky header first ---\n    var existing = document.getElementById('stickyHeader');\n    if (existing) existing.remove();\n\n    \/\/ --- 2. Create the single sticky header ---\n    var header = document.createElement('div');\n    header.id = 'stickyHeader';\n    header.style.width = '100%';\n    header.style.position = 'fixed';\n    header.style.top = '0';\n    header.style.left = '0';\n    header.style.zIndex = '9999';\n\n    \/\/ Center the content\n    header.style.display = 'flex';\n    header.style.justifyContent = 'center';\n    header.style.alignItems = 'center';\n    header.style.minHeight = '100px';   \/\/ adjust to match original image height\n    header.style.background = 'white';  \/\/ remove if you want transparency\n\n    \/\/ --- 3. Add a single big bold plus sign ---\n    var cross = document.createElement('div');\n    cross.textContent = '+';\n    cross.style.fontSize = '150px';      \/\/ larger than before\n    cross.style.fontWeight = 'bold';\n    cross.style.lineHeight = '1';\n    cross.style.textAlign = 'center';\n\n    header.appendChild(cross);\n    document.body.insertBefore(header, document.body.firstChild);\n\n    \/\/ --- 4. Hide the Next button ---\n    this.hideNextButton();\n\n    \/\/ --- 5. Remove cross & auto-advance after 2.5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp;<br>","DataExportTag":"Q530","QuestionID":"QID530"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID531","SecondaryAttribute":"\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">&nbsp;<img style=\"width: 399px; height: 280px;\" src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_6LH2hpR3ryYpi5g\"><\/div>","QuestionJS":false,"DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":37,"NextAnswerId":1,"Graphics":"IM_e3tZiBPIiiVzzE1","GraphicsDescription":"wm1659c.jpg","QuestionText_Unsafe":"<div style=\"text-align: center;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <img src=\"https:\/\/virginia.az1.qualtrics.com\/CP\/Graphic.php?IM=IM_doi7pVCvvCCCrCS\" style=\"