-- 5. Remove cross & auto-advance after 2.5 seconds ---\n    var that = this;\n    setTimeout(function () {\n        var h = document.getElementById('stickyHeader');\n        if (h) h.remove();             \/\/ make the plus sign disappear\n        that.clickNextButton();        \/\/ then advance\n    }, 2500);\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionText_Unsafe":"&nbsp;<br>","DataExportTag":"Q3339","QuestionID":"QID3339"}},{"SurveyID":"SV_aUYX8XjalY6EcDk","Element":"SQ","PrimaryAttribute":"QID334","SecondaryAttribute":"Which of these labels best describes the facial expression currently on display?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of these labels best describes the facial expression currently on display?<br>","QuestionType":"MC","Selector":"SACOL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW","NumColumns":3},"QuestionDescription":"Which of these labels best describes the facial expression currently on display?","Choices":{"1":{"Display":"happiness"},"2":{"Display":"sadness"},"3":{"Display":"anger"},"4":{"Display":"fear"},"5":{"Display":"surprise"},"6":{"Display":"disgust"},"7":{"Display":"neutral"},"8":{"Display":"calm"},"9":{"Display":"none of the above"}},"ChoiceOrder":[1,2,3,4,5,6,7,8,9],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":10,"NextAnswerId":1,"SubSelector":"TX","AnalyzeChoices":{"9":"No"},"DynamicChoicesData":[],"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    var qDiv = document.getElementById(\"QID334\");\n\n    if (qDiv) {\n        \/\/ Tighten QID8 itself\n        q